import Formalization.Online.Regret.T3.OnlineRegretT3ConditionalVariance
import Formalization.Probability.FreedmanExactAssembly

/-! Fixed-time Freedman application to the actual padded T₃ process. -/

namespace StatisticalRL.OnlineRL
open MeasureTheory ProbabilityTheory

universe uState uAction
variable {State : Type uState} {Action : Type uAction}
  [Fintype State] [Fintype Action]
noncomputable local instance t3FreedmanStateMeasurable : MeasurableSpace State :=
  StatisticalRL.FiniteDistribution.empiricalRowStateMeasurable
noncomputable local instance t3FreedmanSampleMeasurable (H K : ℕ) :
    MeasurableSpace ((Fin K → State) × OnlineOutcomePath.{uState, 0} State (K * H)) :=
  StatisticalRL.FiniteDistribution.empiricalRowStateMeasurable
noncomputable local instance t3FreedmanStateDecidable : DecidableEq State := Classical.decEq State
noncomputable local instance t3FreedmanActionDecidable : DecidableEq Action := Classical.decEq Action

/-- The filtration generated by the full reset vector and the first `n`
records of the actual reconstructed transcript. -/
noncomputable def onlineT3ActualPrefixFiltration
    (H K : ℕ) (hH : 0 < H) (fallback : State)
    (planner : OnlineEpisodePlanner State Action H) :
    Filtration ℕ (⊤ : MeasurableSpace
      ((Fin K → State) × OnlineOutcomePath.{uState, 0} State (K * H))) where
  seq := onlineT3CommonPrefixSigma H K (K * H) hH fallback planner
  mono' := by
    intro n j hnj
    exact onlineT3PaddedFiltration_mono H K hH fallback planner hnj
  le' := by
    intro n
    exact le_top

/-- The predictable second-moment sum of the padded T₃ process is the sum of
its actual selected-row continuation variances, almost surely. -/
theorem onlineT3PredictableSecondMomentSum_eq_rowVarianceSum
    (H K : ℕ) (hH : 0 < H) (E : Fin H → EnvironmentStage State Action)
    (ρ : FiniteDistribution State) (fallback : State)
    (planner : OnlineEpisodePlanner State Action H) (L c₁ c₂ : ℝ) :
    let μ := (onlineSequentialEpisodeLaw H K hH E ρ fallback planner (K * H)).rowMeasure
    let ℱ := onlineT3ActualPrefixFiltration H K hH fallback planner
    ∀ N, ∀ᵐ sample ∂μ,
      predictableSecondMomentSum μ ℱ
        (onlineT3PaddedY H K hH E ρ fallback planner L c₁ c₂) N sample =
      ∑ n ∈ Finset.range N,
        onlineT3PaddedRowVariance H K hH E fallback planner L c₁ c₂ n sample := by
  classical
  dsimp
  let μ := (onlineSequentialEpisodeLaw H K hH E ρ fallback planner (K * H)).rowMeasure
  let ℱ := onlineT3ActualPrefixFiltration H K hH fallback planner
  let X := onlineT3PaddedY H K hH E ρ fallback planner L c₁ c₂
  let V := onlineT3PaddedRowVariance H K hH E fallback planner L c₁ c₂
  have hterm (n : ℕ) :
      μ[fun sample => X n sample ^ 2 | ℱ n] =ᵐ[μ] fun sample => V n sample := by
    simpa [μ, ℱ, X, V, onlineT3ActualPrefixFiltration] using
      (onlineT3PaddedY_sq_condExp_eq_rowVariance
        H K hH E ρ fallback planner L c₁ c₂ n)
  intro N
  induction N with
  | zero =>
      filter_upwards [] with sample
      simp [predictableSecondMomentSum]
  | succ N ih =>
      have hlast := hterm N
      filter_upwards [ih, hlast] with sample hprev hlast
      change (∑ n ∈ Finset.range (N + 1), μ[fun ω => X n ω ^ 2 | ℱ n] sample) =
        ∑ n ∈ Finset.range (N + 1), V n sample
      rw [Finset.sum_range_succ, Finset.sum_range_succ]
      change (∑ n ∈ Finset.range N, μ[fun ω => X n ω ^ 2 | ℱ n] sample) =
        ∑ n ∈ Finset.range N, V n sample at hprev
      rw [hprev, hlast]

/-- The actual predictable variance accumulated by time `K*H` is at most
`K*H^3`; each of its `K*H` terms is an actual row variance bounded by `H^2`. -/
theorem onlineT3PredictableSecondMomentSum_le_KH3
    (H K : ℕ) (hH : 0 < H) (E : Fin H → EnvironmentStage State Action)
    (ρ : FiniteDistribution State) (fallback : State)
    (planner : OnlineEpisodePlanner State Action H) (L c₁ c₂ : ℝ)
    (hL : 0 ≤ L) (hc₁ : 0 ≤ c₁) (hc₂ : 0 ≤ c₂) :
    let μ := (onlineSequentialEpisodeLaw H K hH E ρ fallback planner (K * H)).rowMeasure
    let ℱ := onlineT3ActualPrefixFiltration H K hH fallback planner
    ∀ᵐ sample ∂μ, predictableSecondMomentSum μ ℱ
      (onlineT3PaddedY H K hH E ρ fallback planner L c₁ c₂) (K * H) sample ≤
        (K : ℝ) * (H : ℝ)^3 := by
  classical
  dsimp
  let μ : Measure ((Fin K → State) × OnlineOutcomePath.{uState, 0} State (K * H)) :=
    (onlineSequentialEpisodeLaw H K hH E ρ fallback planner (K * H)).rowMeasure
  let ℱ : Filtration ℕ (⊤ : MeasurableSpace
      ((Fin K → State) × OnlineOutcomePath.{uState, 0} State (K * H))) :=
    onlineT3ActualPrefixFiltration H K hH fallback planner
  let X := onlineT3PaddedY H K hH E ρ fallback planner L c₁ c₂
  let V := onlineT3PaddedRowVariance H K hH E fallback planner L c₁ c₂
  have hsum := onlineT3PredictableSecondMomentSum_eq_rowVarianceSum
    H K hH E ρ fallback planner L c₁ c₂ (K * H)
  filter_upwards [hsum] with sample hsample
  rw [hsample]
  calc
    (∑ n ∈ Finset.range (K * H), V n sample) ≤
        ∑ _n ∈ Finset.range (K * H), (H : ℝ)^2 := by
          apply Finset.sum_le_sum
          intro n hn
          exact (onlineT3PaddedRowVariance_le_H_sq H K hH E fallback planner
            L c₁ c₂ hL hc₁ hc₂ n sample).2
    _ = (K : ℝ) * (H : ℝ)^3 := by
      simp only [Finset.sum_const, Finset.card_range, nsmul_eq_mul]
      push_cast
      ring

/-- The source Freedman event for the actual padded T₃ sum, with its random
predictable variance and a deterministic `K*H^3` ceiling. -/
theorem onlineT3Freedman_fixed_time
    (H K j : ℕ) (hH : 0 < H) (E : Fin H → EnvironmentStage State Action)
    (ρ : FiniteDistribution State) (fallback : State)
    (planner : OnlineEpisodePlanner State Action H) (L c₁ c₂ δ : ℝ)
    (hL : 0 ≤ L) (hc₁ : 0 ≤ c₁) (hc₂ : 0 ≤ c₂)
    (hJ : 0 < j) (hδ : 0 < δ) (hδ1 : δ < 1) :
    let μ := (onlineSequentialEpisodeLaw H K hH E ρ fallback planner (K * H)).rowMeasure
    let ℱ := onlineT3ActualPrefixFiltration H K hH fallback planner
    1 - δ ≤ μ.real {sample |
      |incrementSum (onlineT3PaddedY H K hH E ρ fallback planner L c₁ c₂) (K * H) sample| ≤
        Real.sqrt (8 * max
          (predictableSecondMomentSum μ ℱ
            (onlineT3PaddedY H K hH E ρ fallback planner L c₁ c₂) (K * H) sample)
          (((K : ℝ) * (H : ℝ)^3) / (2 : ℝ)^j) * Real.log (2 * j / δ)) +
        (4 / 3) * (H : ℝ) * Real.log (2 * j / δ)} := by
  classical
  dsimp
  let μ := (onlineSequentialEpisodeLaw H K hH E ρ fallback planner (K * H)).rowMeasure
  let ℱ := onlineT3ActualPrefixFiltration H K hH fallback planner
  let X := onlineT3PaddedY H K hH E ρ fallback planner L c₁ c₂
  haveI : IsProbabilityMeasure μ := by
    dsimp [μ]
    infer_instance
  have hX : ∀ n, StronglyMeasurable[ℱ (n + 1)] (X n) := by
    intro n
    exact (onlineT3PaddedY_measurable_next H K hH E ρ fallback planner L c₁ c₂ n).stronglyMeasurable
  have hb : ∀ n, ∀ᵐ sample ∂μ, |X n sample| ≤ (H : ℝ) := by
    intro n
    exact Filter.Eventually.of_forall
      (fun sample => onlineT3PaddedY_abs_le_H H K hH E ρ fallback planner
        L c₁ c₂ hL hc₁ hc₂ n sample)
  have hc : ∀ n, μ[X n | ℱ n] =ᵐ[μ] fun _ => 0 := by
    intro n
    exact onlineT3PaddedY_condExp_zero H K hH E ρ fallback planner L c₁ c₂ n
  have hcap := onlineT3PredictableSecondMomentSum_le_KH3
    H K hH E ρ fallback planner L c₁ c₂ hL hc₁ hc₂
  exact StatisticalRL.freedman_source_bound μ ℱ X (H : ℝ)
    ((K : ℝ) * (H : ℝ)^3) (by positivity) (by positivity)
    hX hb hc (K * H) j hJ hcap δ hδ hδ1

end StatisticalRL.OnlineRL
