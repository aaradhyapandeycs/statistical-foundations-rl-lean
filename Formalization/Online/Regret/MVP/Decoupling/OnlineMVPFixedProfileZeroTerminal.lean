import Formalization.Online.Regret.MVP.Model.OnlineMVPActualPlanningAdapter
import Formalization.Online.SourceOptimism.CappedBackwardRecursion

/-! Corrected terminal-zero finite-family carrier for fixed-profile values.
This is auxiliary infrastructure only: it does not prove that the source's
expanded-sample profile process equals the actual adaptive stack process or
transport a profile event between their laws. -/

namespace StatisticalRL.OnlineRL

open MeasureTheory ProbabilityTheory

variable {State Action : Type*} [Fintype State] [Fintype Action]

/-- The finite family of capped-backward values generated by one fixed code
for each of the K episodes, with zero adjoined as in Assumption X. The
underlying recursion's empty suffix is zero, matching the deployed algorithm's
terminal continuation. -/
noncomputable def onlineMVPZeroTerminalValueFamily
    {K : ℕ} (cap L c₁ c₂ : ℝ)
    (episodeStages : Fin K → List (OnlineObservedPlanningStage State Action))
    (h : ℕ) : Finset (State → ℝ) := by
  classical
  exact insert (fun _ => 0) (Finset.univ.image fun k =>
    onlineCappedBackwardValueAt cap L c₁ c₂ (episodeStages k) h)

theorem onlineMVPZeroTerminalValueFamily_zero_mem
    {K : ℕ} (cap L c₁ c₂ : ℝ)
    (episodeStages : Fin K → List (OnlineObservedPlanningStage State Action))
    (h : ℕ) : (fun _ : State => 0) ∈
      onlineMVPZeroTerminalValueFamily cap L c₁ c₂ episodeStages h := by
  classical
  simp [onlineMVPZeroTerminalValueFamily]

theorem onlineMVPZeroTerminalValueFamily_card_le
    {K : ℕ} (cap L c₁ c₂ : ℝ)
    (episodeStages : Fin K → List (OnlineObservedPlanningStage State Action))
    (h : ℕ) :
    (onlineMVPZeroTerminalValueFamily cap L c₁ c₂ episodeStages h).card ≤ K + 1 := by
  classical
  unfold onlineMVPZeroTerminalValueFamily
  calc
    _ ≤ (Finset.univ.image (fun k : Fin K =>
          onlineCappedBackwardValueAt cap L c₁ c₂ (episodeStages k) h)).card + 1 :=
      Finset.card_insert_le _ _
    _ ≤ (Finset.univ : Finset (Fin K)).card + 1 :=
      Nat.add_le_add_right Finset.card_image_le 1
    _ = K + 1 := by simp

theorem onlineMVPZeroTerminalValueFamily_range
    {K : ℕ} (cap L c₁ c₂ : ℝ)
    (hcap : 0 ≤ cap) (hL : 0 ≤ L) (hc₁ : 0 ≤ c₁) (hc₂ : 0 ≤ c₂)
    (episodeStages : Fin K → List (OnlineObservedPlanningStage State Action))
    (h : ℕ) {v : State → ℝ}
    (hv : v ∈ onlineMVPZeroTerminalValueFamily cap L c₁ c₂ episodeStages h) :
    ∀ s, 0 ≤ v s ∧ v s ≤ cap := by
  classical
  rcases Finset.mem_insert.mp hv with hv0 | hvImage
  · rw [hv0]
    intro s
    exact ⟨le_rfl, hcap⟩
  · rcases Finset.mem_image.mp hvImage with ⟨k, _hk, hvk⟩
    rw [← hvk]
    exact (onlineCappedBackwardAt_range cap L c₁ c₂ hcap hL hc₁ hc₂
      (episodeStages k) h).1

/-- A length-H stage list has exactly zero continuation at the H+1 boundary.
This is the deployed algorithm's terminal convention. -/
theorem onlineMVPZeroTerminalValueAt_terminal_zero
    {H : ℕ} (cap L c₁ c₂ : ℝ)
    (stages : List (OnlineObservedPlanningStage State Action))
    (hlen : stages.length = H) :
    onlineCappedBackwardValueAt cap L c₁ c₂ stages H = fun _ => 0 := by
  funext s
  unfold onlineCappedBackwardValueAt
  rw [← hlen, List.drop_length]
  rfl

/-- If every episode's stage list has length H, the corrected next-stage
family at the terminal boundary is precisely the singleton zero family. -/
theorem onlineMVPZeroTerminalValueFamily_terminal_eq_singleton
    {H K : ℕ} (cap L c₁ c₂ : ℝ)
    (episodeStages : Fin K → List (OnlineObservedPlanningStage State Action))
    (hlen : ∀ k, (episodeStages k).length = H) :
    onlineMVPZeroTerminalValueFamily cap L c₁ c₂ episodeStages H = {0} := by
  classical
  unfold onlineMVPZeroTerminalValueFamily
  ext v
  constructor
  · intro hv
    rcases Finset.mem_insert.mp hv with hv0 | hvImage
    · simpa using hv0
    · rcases Finset.mem_image.mp hvImage with ⟨k, _hk, hvalue⟩
      rw [onlineMVPZeroTerminalValueAt_terminal_zero cap L c₁ c₂
        (episodeStages k) (hlen k)] at hvalue
      simpa using hvalue.symm
  · intro hv
    have hv0 : v = 0 := by simpa using hv
    exact Finset.mem_insert.mpr (Or.inl hv0)

/-- The actual value table computed from the transcript-reconstructed stages
is exactly the value table computed from the sampler's row/successor arrays.
This is a pathwise value identity, not yet the fixed-profile auxiliary
identity from the source decoupling proof. -/
theorem onlineMVPHistoryValueAt_actualStack_eq
    {H K : ℕ} (hH : 0 < H) (E : Fin H → EnvironmentStage State Action)
    (initial : Fin K → State) (fallback : State)
    (planner : OnlineEpisodePlanner State Action H)
    (data : OnlineMDPRow State Action H × Fin K → State) (n h : ℕ)
    (cap L c₁ c₂ : ℝ) :
    letI : Nonempty State := (E ⟨0, hH⟩).state_nonempty
    onlineCappedBackwardValueAt cap L c₁ c₂
      (onlineMVPHistoryPlanningStages hH E fallback
        (onlineMVPActualStackHistory hH initial fallback planner data n)) h =
    onlineCappedBackwardValueAt cap L c₁ c₂
      (List.ofFn (fun j : Fin H => onlineMVPActualPlanningStage E
        (onlineMVPActualStackRowAt hH initial fallback planner data)
        (onlineMVPActualStackNextAt hH initial fallback planner data) n j)) h := by
  rw [onlineMVPHistoryPlanningStages_actualStack_eq]

/-- A deterministic future-code map: once the episode-indexed stage suffixes
are fixed, the family of next-stage values is fixed. To discharge the source
future-dependence condition, a caller must still prove that those suffixes are
functions only of the fixed profile, rewards, and future empirical rows. -/
noncomputable def onlineMVPZeroTerminalFutureCode
    {K : ℕ} (cap L c₁ c₂ : ℝ)
    {Code : Type*} (stagesFromCode : Code → Fin K →
      List (OnlineObservedPlanningStage State Action)) (code : Code)
    (h : ℕ) : Finset (State → ℝ) :=
  onlineMVPZeroTerminalValueFamily cap L c₁ c₂ (stagesFromCode code) (h + 1)

theorem onlineMVPZeroTerminalFutureCode_eq_family
    {K : ℕ} (cap L c₁ c₂ : ℝ)
    {Code : Type*} (stagesFromCode : Code → Fin K →
      List (OnlineObservedPlanningStage State Action)) (code : Code)
    (h : ℕ) :
    onlineMVPZeroTerminalFutureCode cap L c₁ c₂ stagesFromCode code h =
      onlineMVPZeroTerminalValueFamily cap L c₁ c₂ (stagesFromCode code) (h + 1) := rfl

end StatisticalRL.OnlineRL
