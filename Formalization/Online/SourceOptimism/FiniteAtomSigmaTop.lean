import Formalization.Online.SourceOptimism.SequentialEpisodeLaw
import Mathlib.MeasureTheory.MeasurableSpace.Constructions

/-! The standard finite Pi/product measurable space for the reset/path atom.
The staged counterpart compiled; this canonical import layout requires verification. -/
namespace StatisticalRL.OnlineRL
open MeasureTheory

variable {State : Type*} [Fintype State]

/-- The standard finite-path measurable space, recursively formed from the
PUnit action, the state space, and the shorter path. -/
def onlineOutcomePathProductSigma (mState : MeasurableSpace State) :
    (n : ℕ) → MeasurableSpace (OnlineOutcomePath State n)
  | 0 => ⊤
  | n + 1 => MeasurableSpace.prod (⊤ : MeasurableSpace PUnit)
      (MeasurableSpace.prod mState (onlineOutcomePathProductSigma mState n))

/-- The default measurable space on the finite reset vector, written as the
Pi sigma algebra generated by the state-coordinate projections. -/
def onlineResetVectorProductSigma (mState : MeasurableSpace State) (K : ℕ) :
    MeasurableSpace (Fin K → State) :=
  @MeasurableSpace.pi (Fin K) (fun _ : Fin K => State) (fun _ => mState)

/-- The ordinary product measurable space on a reset vector and a finite path,
with both the Pi and product structures explicit. -/
def onlineFiniteResetPathProductSigma (mState : MeasurableSpace State)
    (K n : ℕ) : MeasurableSpace ((Fin K → State) × OnlineOutcomePath State n) :=
  MeasurableSpace.prod (onlineResetVectorProductSigma mState K)
    (onlineOutcomePathProductSigma mState n)

private theorem onlineOutcomePathProductSigma_singletons
    (mState : MeasurableSpace State)
    (hState : @MeasurableSingletonClass State mState) (n : ℕ) :
    @MeasurableSingletonClass (OnlineOutcomePath State n)
      (onlineOutcomePathProductSigma mState n) := by
  induction n with
  | zero =>
      change @MeasurableSingletonClass PUnit (⊤ : MeasurableSpace PUnit)
      infer_instance
  | succ n ih =>
      letI : MeasurableSpace State := mState
      letI : MeasurableSingletonClass State := hState
      letI : MeasurableSpace (OnlineOutcomePath State n) :=
        onlineOutcomePathProductSigma mState n
      letI : MeasurableSingletonClass (OnlineOutcomePath State n) := ih
      change @MeasurableSingletonClass (PUnit × (State × OnlineOutcomePath State n))
        (MeasurableSpace.prod (⊤ : MeasurableSpace PUnit)
          (MeasurableSpace.prod mState (onlineOutcomePathProductSigma mState n)))
      infer_instance

private theorem onlineResetVectorProductSigma_singletons
    (mState : MeasurableSpace State)
    (hState : @MeasurableSingletonClass State mState) (K : ℕ) :
    @MeasurableSingletonClass (Fin K → State)
      (onlineResetVectorProductSigma mState K) := by
  letI : ∀ _ : Fin K, MeasurableSpace State := fun _ => mState
  letI : MeasurableSpace State := mState
  letI : MeasurableSingletonClass State := hState
  exact inferInstanceAs
    (@MeasurableSingletonClass (Fin K → State) (onlineResetVectorProductSigma mState K))

private theorem onlineFiniteResetPathProductSigma_singletons
    (mState : MeasurableSpace State)
    (hState : @MeasurableSingletonClass State mState) (K n : ℕ) :
    @MeasurableSingletonClass ((Fin K → State) × OnlineOutcomePath State n)
      (onlineFiniteResetPathProductSigma mState K n) := by
  letI : MeasurableSpace (Fin K → State) := onlineResetVectorProductSigma mState K
  letI : MeasurableSingletonClass (Fin K → State) :=
    onlineResetVectorProductSigma_singletons mState hState K
  letI : MeasurableSpace (OnlineOutcomePath State n) :=
    onlineOutcomePathProductSigma mState n
  letI : MeasurableSingletonClass (OnlineOutcomePath State n) :=
    onlineOutcomePathProductSigma_singletons mState hState n
  change @MeasurableSingletonClass ((Fin K → State) × OnlineOutcomePath State n)
    (MeasurableSpace.prod (onlineResetVectorProductSigma mState K)
      (onlineOutcomePathProductSigma mState n))
  infer_instance

private theorem finiteMeasurableSpace_eq_top_of_singletons
    {α : Type*} (m : MeasurableSpace α) [Fintype α]
    (hsingleton : ∀ x : α, MeasurableSet[m] ({x} : Set α)) : m = ⊤ := by
  letI : MeasurableSpace α := m
  letI : MeasurableSingletonClass α := ⟨hsingleton⟩
  apply le_antisymm le_top
  intro s _
  exact (Set.to_countable s).measurableSet

/-- For the actual finite reset/path atom carrier, the standard default Pi and
product measurable space is the discrete (top) sigma algebra. This states the
generated structure explicitly; it is not proved by assuming that structure
already is top. -/
theorem onlineFiniteResetPathProductSigma_eq_top (K n : ℕ) :
    onlineFiniteResetPathProductSigma (State := State) (⊤ : MeasurableSpace State)
      K n = ⊤ := by
  letI : MeasurableSpace State := ⊤
  have hState : @MeasurableSingletonClass State (⊤ : MeasurableSpace State) := by
    infer_instance
  letI : Fintype (Fin K → State) := inferInstance
  letI : Fintype (OnlineOutcomePath State n) := inferInstance
  letI : Fintype ((Fin K → State) × OnlineOutcomePath State n) := inferInstance
  let m := onlineFiniteResetPathProductSigma (State := State) (⊤ : MeasurableSpace State) K n
  letI : MeasurableSpace ((Fin K → State) × OnlineOutcomePath State n) := m
  letI : MeasurableSingletonClass ((Fin K → State) × OnlineOutcomePath State n) :=
    onlineFiniteResetPathProductSigma_singletons
      (State := State) (⊤ : MeasurableSpace State) hState K n
  exact finiteMeasurableSpace_eq_top_of_singletons m
    (fun x => MeasurableSet.singleton x)

end StatisticalRL.OnlineRL
