import Formalization.Probability.FreedmanExactAssembly

/-! The source Freedman lemma on the sigma-algebra generated by the actual
prior increments; no externally supplied filtration is required. -/
open MeasureTheory
open scoped BigOperators
namespace StatisticalRL
variable {Ω : Type*} [m₀ : MeasurableSpace Ω]

/-- Exactly the sigma-algebra generated by increments with index below n. -/
def priorIncrementSigma (X : ℕ → Ω → ℝ) (n : ℕ) : MeasurableSpace Ω :=
  ⨆ k, ⨆ (_ : k < n), MeasurableSpace.comap (X k) (borel ℝ)

omit m₀ in
/-- No increment is observed before the first one. -/
theorem priorIncrementSigma_zero (X : ℕ → Ω → ℝ) : priorIncrementSigma X 0 = ⊥ := by
  simp [priorIncrementSigma]

/-- Padding by a deterministic time-zero observation aligns Mathlib's
inclusive natural filtration with the source's strict past. -/
def paddedIncrementHistory (X : ℕ → Ω → ℝ) : ℕ → Ω → ℝ
  | 0 => fun _ ↦ 0
  | n + 1 => X n

theorem paddedIncrementHistory_measurable (X : ℕ → Ω → ℝ)
    (hX : ∀ n, Measurable (X n)) (n : ℕ) :
    StronglyMeasurable (paddedIncrementHistory X n) := by
  cases n with
  | zero => exact stronglyMeasurable_const
  | succ n => exact (hX n).stronglyMeasurable

/-- Actual natural-history filtration, constructed from source random variables. -/
def priorIncrementFiltration (X : ℕ → Ω → ℝ) (hX : ∀ n, Measurable (X n)) :
    Filtration ℕ m₀ :=
  Filtration.natural (paddedIncrementHistory X) (paddedIncrementHistory_measurable X hX)

/-- The natural filtration is exactly the strict prior-increment sigma-algebra,
including the trivial history before the first increment. -/
theorem priorIncrementFiltration_eq (X : ℕ → Ω → ℝ)
    (hX : ∀ n, Measurable (X n)) (n : ℕ) :
    priorIncrementFiltration X hX n = priorIncrementSigma X n := by
  change (⨆ j, ⨆ (_ : j ≤ n), MeasurableSpace.comap (paddedIncrementHistory X j) (borel ℝ)) = _
  apply le_antisymm
  · apply iSup₂_le
    intro j hj
    cases j with
    | zero => simp [paddedIncrementHistory]
    | succ k =>
      exact le_iSup₂_of_le k (by omega : k < n) le_rfl
  · apply iSup₂_le
    intro k hk
    exact le_iSup₂_of_le (k + 1) (by omega : k + 1 ≤ n) le_rfl

/-- The next actual increment is measurable when it is revealed. -/
theorem increment_stronglyMeasurable_prior (X : ℕ → Ω → ℝ)
    (hX : ∀ n, Measurable (X n)) (n : ℕ) :
    StronglyMeasurable[priorIncrementFiltration X hX (n + 1)] (X n) := by
  exact Filtration.adapted_natural (paddedIncrementHistory_measurable X hX) (n + 1)

/-- The source cumulative conditional second moment uses precisely its past
increment sigma-algebra, without reference to an external filtration. -/
noncomputable def historyPredictableVariance (μ : Measure Ω) (X : ℕ → Ω → ℝ)
    (n : ℕ) (ω : Ω) : ℝ :=
  ∑ k ∈ Finset.range n, μ[fun ω' ↦ X k ω' ^ 2 | priorIncrementSigma X k] ω

theorem predictableSecondMomentSum_prior_eq (μ : Measure Ω) (X : ℕ → Ω → ℝ)
    (hX : ∀ n, Measurable (X n)) (n : ℕ) :
    predictableSecondMomentSum μ (priorIncrementFiltration X hX) X n =
      historyPredictableVariance μ X n := by
  funext ω
  simp only [predictableSecondMomentSum, historyPredictableVariance, priorIncrementFiltration_eq]

/-- Source natural-history Freedman lemma: conditional centering and variance
are stated on exactly the sigma-algebra generated by prior increments. -/
theorem freedman_natural_history
    (μ : Measure Ω) [IsProbabilityMeasure μ] (X : ℕ → Ω → ℝ)
    (hX : ∀ n, Measurable (X n)) (B σ₂ : ℝ) (hB : 0 ≤ B) (hσ : 0 ≤ σ₂)
    (hb : ∀ n, ∀ᵐ ω ∂μ, |X n ω| ≤ B)
    (hc : ∀ n, μ[X n | priorIncrementSigma X n] =ᵐ[μ] fun _ ↦ 0)
    (n K : ℕ) (hK : 0 < K)
    (hcap : ∀ᵐ ω ∂μ, historyPredictableVariance μ X n ω ≤ σ₂)
    (δ : ℝ) (hδ : 0 < δ) (hδ1 : δ < 1) :
    1 - δ ≤ μ.real {ω | |incrementSum X n ω| ≤
      Real.sqrt (8 * max (historyPredictableVariance μ X n ω)
        (σ₂ / (2 : ℝ) ^ K) * Real.log (2 * K / δ)) +
        (4 / 3) * B * Real.log (2 * K / δ)} := by
  have hcenter (k : ℕ) : μ[X k | priorIncrementFiltration X hX k] =ᵐ[μ] fun _ ↦ 0 := by
    simpa only [priorIncrementFiltration_eq] using hc k
  have hcap' : ∀ᵐ ω ∂μ, predictableSecondMomentSum μ (priorIncrementFiltration X hX) X n ω ≤ σ₂ := by
    simpa only [predictableSecondMomentSum_prior_eq] using hcap
  have hp := freedman_source_bound μ (priorIncrementFiltration X hX) X B σ₂ hB hσ
    (increment_stronglyMeasurable_prior X hX) hb hcenter n K hK hcap' δ hδ hδ1
  simpa only [predictableSecondMomentSum_prior_eq] using hp

end StatisticalRL
